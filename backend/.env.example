# ── Flask ────────────────────────────────────────────────────────────────────
FLASK_ENV=development          # development | production | testing
SECRET_KEY=change-me-in-production
PORT=5000

# ── JWT ──────────────────────────────────────────────────────────────────────
JWT_SECRET_KEY=change-me-jwt-secret
JWT_EXPIRES_HOURS=24

# ── Database ─────────────────────────────────────────────────────────────────
# Development (SQLite — no setup needed):
# DATABASE_URL=sqlite:///movie_db.sqlite   ← default, no need to set

# Production (PostgreSQL):
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# ── CORS ─────────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000

# Administration
# Admin identities are separate from normal application users.
ADMIN_JWT_SECRET_KEY=change-me-admin-jwt-secret
ADMIN_SESSION_HOURS=4
FRONTEND_URL=http://localhost:3000
PASSWORD_RESET_MINUTES=30

# TMDB API
# Keep credentials in this backend file. Never expose them through React.
TMDB_API_KEY=
# TMDB_READ_TOKEN=             # optional alternative to the API v3 key
TMDB_LANGUAGE=en-US
TMDB_TIMEOUT_SECONDS=5
TMDB_CACHE_TTL_SECONDS=86400
TMDB_FAILURE_TTL_SECONDS=300
TMDB_CACHE_MAX_ENTRIES=2048
TMDB_MAX_WORKERS=8
