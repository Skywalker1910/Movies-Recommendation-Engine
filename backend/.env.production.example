# ---- PRODUCTION ENVIRONMENT ----
# Copy this file to .env.production and fill in real values on the EC2 instance.
# NEVER commit this file with real secrets.

FLASK_ENV=production
SECRET_KEY=CHANGE_ME_generate_with_python_-c_import_secrets;print(secrets.token_urlsafe(64))
JWT_SECRET_KEY=CHANGE_ME_generate_a_different_one
ADMIN_JWT_SECRET_KEY=CHANGE_ME_generate_a_third_one

# SQLite is fine for 3-5 users/week
# DATABASE_URL=sqlite:///movie_db.sqlite

# CORS: set to your EC2 public IP or domain
CORS_ORIGINS=http://localhost
FRONTEND_URL=http://localhost

# TMDB (get your key at https://www.themoviedb.org/settings/api)
TMDB_API_KEY=

# Admin
ADMIN_SESSION_HOURS=4
PASSWORD_RESET_MINUTES=30

# ML model directory override (container path)
MODELS_DIR=/workspace/models
